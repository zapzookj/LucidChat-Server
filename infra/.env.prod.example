# [2026-08-18 탈AWS] 프로덕션 .env 템플릿 — 서버의 /opt/lucid/.env 로 복사 후 실값 기입.
# 실값 소스: 구 ECS 태스크 정의 리비전(콘솔에 이력 잔존) 또는 종원 보관분.
# ⚠ 이 example 파일 외에 실값이 든 .env는 절대 리포에 커밋 금지.

# ── Spring 프로필 ──
SPRING_PROFILES_ACTIVE=prod,characters,worlds,v2
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# ── DB (compose 내부 postgres 컨테이너 — DB_HOST는 compose가 postgres로 덮음) ──
DB_HOST=postgres
DB_NAME=lucidchat
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME

# ── 외부 저장소 (AWS 밖 — 기존 값 그대로) ──
MONGO_URI=mongodb+srv://...
REDIS_HOST=....upstash.io
REDIS_PASSWORD=CHANGE_ME

# ── 오브젝트 스토리지: Cloudflare R2 (S3 호환) ──
# AWS_ACCESS_KEY/SECRET에는 R2 API 토큰의 Access Key ID / Secret을 넣는다.
AWS_ACCESS_KEY=R2_TOKEN_ACCESS_KEY_ID
AWS_SECRET_KEY=R2_TOKEN_SECRET
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=lucid-chat-assets-v2
# 공개 CDN 도메인 (R2 버킷 커스텀 도메인) — DB·시드의 에셋 URL 프리픽스와 일치해야 함
CLOUDFRONT_ASSETS_URL=https://assets.lucid-chat.com

# ── 인증/보안 ──
JWT_SECRET_BASE64=CHANGE_ME
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
NAVER_CLIENT_ID=CHANGE_ME
NAVER_CLIENT_SECRET=CHANGE_ME

# ── LLM/이미지 파이프라인 ──
OPENROUTER_API_KEY=CHANGE_ME
OPENAI_PRO-MODEL=CHANGE_ME
FAL_API_KEY=CHANGE_ME
MODELSLAB_API_KEY=CHANGE_ME
MODELSLAB_DEFAULT_MODEL_ID=CHANGE_ME
MODELSLAB_WEBHOOK_SECRET=CHANGE_ME

# ── RunPod 워커 (씬/UGC 이미지 생성) ──
SCENE_RUNPOD_ENDPOINT_ID=CHANGE_ME
UGC_RUNPOD_ENDPOINT_ID=CHANGE_ME
UGC_RUNPOD_API_KEY=CHANGE_ME
UGC_RUNPOD_WEBHOOK_SECRET=CHANGE_ME
LUCID_WEBHOOK_BASE=https://api.lucid-chat.com

# ── 백업 (backup.sh 전용 — 앱 미사용) ──
BACKUP_BUCKET=lucid-chat-backups
